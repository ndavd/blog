---
interface Props {
  relativePath: string;
}

const { relativePath } = Astro.props;
---

<style>
  footer {
    margin: 0.5em 0;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 0.5em;
    width: 100%;
    text-align: center;
  }
  @media screen and (max-width: 720px) {
    footer {
      font-size: 0.8em;
    }
  }
</style>
<footer>
  <div
    style={{
      display: "flex",
      gap: "0.5em",
    }}
  >
    <a href="https://ndavd.com">ndavd.com</a>
    <div>
      (These thoughts are <a href="https://github.com/ndavd/blog">open-source</a
      >🖋️)
    </div>
    <a href={`${relativePath}/feed.xml`}>RSS</a>
  </div>
</footer>
